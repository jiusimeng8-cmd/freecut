# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# 剪好 MCP（智能剪辑、ASR、Skills 共用；Desktop 的 Key 保存在 safeStorage）
VITE_FREECUT_CLOUD_BASE_URL=
VITE_FREECUT_CLOUD_BUSINESS_KEY=
VITE_FREECUT_AI_BUSINESS_MODEL=smart-edit-fast

# ===========================================
# Windows Desktop Packaging
# ===========================================

# electron-builder 写入 app-update.yml 的正式更新源。
FREECUT_UPDATE_URL=

# 自签名 Development 包可选的 HTTPS 版本清单；为空时不检查更新。
FREECUT_UPDATE_MANIFEST_URL=

# 必须与 Authenticode 证书的发布者名称一致，用于验证更新安装包签名。
FREECUT_PUBLISHER_NAME=

# Authenticode RFC 3161 时间戳服务。
FREECUT_WINDOWS_TIMESTAMP_URL=

# 可选：覆盖本机资源准备脚本自动发现的 FFmpeg 路径。
FREECUT_FFMPEG_PATH=
FREECUT_FFPROBE_PATH=

# 正式发布必须提供 Authenticode 代码签名证书。
CSC_LINK=
CSC_KEY_PASSWORD=
